{
  "name": "auto-growing-screeps",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsx ops/buildModules.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "deploy": "npm run build && tsx ops/deploy.ts",
    "deploy:private": "npm run build && tsx ops/deploy.ts",
    "metrics:pull": "tsx ops/metricsPull.ts",
    "agent:evolve": "tsx ops/evolveAgent.ts",
    "sim:softlock": "npm run build && tsx ops/sim/softLock.ts",
    "sim:boot": "npm run build && tsx ops/sim/boot.ts",
    "sim:economy": "npm run build && tsx ops/sim/economy.ts",
    "sim:surround": "npm run build && tsx ops/sim/surround.ts",
    "sim:miners": "npm run build && tsx ops/sim/miners.ts",
    "sim:containers": "npm run build && tsx ops/sim/containers.ts",
    "sim:climb": "npm run build && tsx ops/sim/rclClimb.ts",
    "sim:real": "npm run build && tsx ops/sim/farm.ts --scenario real --workers 4 --ticks 50000 --base-port 23100 --concurrency 2",
    "sim:roads": "npm run build && tsx ops/sim/farm.ts --scenario real --workers 4 --ticks 50000 --base-port 23200 --concurrency 2 --road-policies after_containers,parallel,after_rcl3,source_first",
    "sim:ab": "npm run build && tsx ops/sim/abExperiment.ts",
    "sim:ab:ext": "npm run build && tsx ops/sim/abExperiment.ts --knob extensionBootstrap --variants 0,2,5 --ticks 50000 --base-port 23300 --concurrency 2",
    "sim:ab:all": "npm run build && tsx ops/sim/abExperiment.ts --all --ticks 50000 --base-port 23300 --concurrency 2",
    "sim:strategy": "tsx ops/sim/strategyBench.ts --replicates 6 --ticks 50000 --concurrency 3 --base-port 26000",
    "sim:haul": "tsx ops/sim/haulBench.ts --replicates 4 --base-port 27100",
    "sim:wipe": "npm run build && tsx ops/sim/wipeRecovery.ts --ticks 50000 --port 27000",
    "sim:storageHub": "npm run build && tsx ops/sim/storageHub.ts --ticks 12000 --port 27200",
    "sim:rcl5": "npm run build && tsx ops/sim/rcl5Climb.ts --ticks 20000 --port 27400",
    "sim:rcl5:bench": "tsx ops/sim/rcl5Bench.ts --replicates 2 --ticks 20000 --concurrency 2 --base-port 27400",
    "sim:rcl5:aftercare": "npm run build && tsx ops/sim/rcl5Aftercare.ts --ticks 20000 --port 27600",
    "sim:rcl5:aftercare:bench": "tsx ops/sim/rcl5AftercareBench.ts --replicates 2 --ticks 20000 --concurrency 2 --base-port 27600",
    "sim:rcl5:aftercare:48h": "tsx ops/sim/rcl5AftercareBench.ts --replicates 2 --ticks 50000 --concurrency 2 --base-port 27600",
    "sim:rcl5:to6": "npm run build && tsx ops/sim/rcl5ToRcl6.ts --ticks 40000 --port 27800",
    "sim:rcl5:to6:bench": "tsx ops/sim/rcl5ToRcl6Bench.ts --replicates 2 --ticks 40000 --concurrency 2 --base-port 27800",
    "sim:rcl5:to6:48h": "tsx ops/sim/rcl5ToRcl6Bench.ts --replicates 2 --ticks 40000 --concurrency 2 --base-port 27800",
    "sim:filler:hub": "npm run build && tsx ops/sim/fillerHub.ts --ticks 20000 --port 28300",
    "sim:filler:hub:bench": "tsx ops/sim/fillerHubBench.ts --replicates 1 --ticks 20000 --concurrency 3 --base-port 28300",
    "sim:attack": "npm run build && tsx ops/sim/attackRaid.ts",
    "sim:attack:bench": "tsx ops/sim/attackRaidBench.ts --ticks 1400 --concurrency 2 --base-port 28800",
    "sim:walls:timing": "npm run build && tsx ops/sim/wallsTiming.ts",
    "sim:walls:timing:bench": "tsx ops/sim/wallsTimingBench.ts --ticks 600 --base-port 29000",
    "sim:remote:income": "npm run build && tsx ops/sim/remoteIncome.ts",
    "sim:remote:income:bench": "tsx ops/sim/remoteIncomeBench.ts --replicates 1 --ticks 15000 --concurrency 2 --base-port 28500",
    "sim:remote:variant:bench": "tsx ops/sim/remoteVariantBench.ts --replicates 1 --ticks 12000 --concurrency 2 --base-port 28600",
    "sim:rcl6:spend": "npm run build && tsx ops/sim/rcl6Spend.ts",
    "sim:rcl6:spend:bench": "tsx ops/sim/rcl6SpendBench.ts --ticks 12000 --base-port 29600",
    "sim:rcl5:gameplan": "tsx ops/sim/rcl5ToRcl6Bench.ts --modes fat_first --plans fat_first,link_boost --replicates 1 --ticks 50000 --concurrency 2 --base-port 27900",
    "sim:real:loop": "npm run build && tsx ops/sim/realLoop.ts --max-rounds 20 --ticks 50000",
    "sim:master": "tsx ops/sim/masterAgent.ts",
    "sim:farm": "npm run build && tsx ops/sim/farm.ts",
    "sim:farm20": "npm run build && tsx ops/sim/farm.ts --workers 8 --quiet",
    "sim:learn": "tsx ops/sim/learnLoop.ts --workers 8",
    "sim:watch": "tsx ops/sim/watch.ts",
    "sim:gui": "tsx ops/sim/gui.ts",
    "sim:bench": "tsx ops/sim/bench.ts",
    "sim:overnight": "tsx ops/sim/overnightAb.ts --ticks 50000 --concurrency 3 --base-port 24000",
    "sim:overnight:resume": "tsx ops/sim/overnightAb.ts --ticks 50000 --concurrency 3 --base-port 24000 --resume --skip-build",
    "sim:overnight:watch": "tsx ops/sim/overnightWatch.ts",
    "sim:overnight:finalize": "tsx ops/sim/overnightAb.ts --finalize-only --ticks 50000 --base-port 25000"
  },
  "devDependencies": {
    "@types/lodash": "^4.17.25",
    "@types/node": "^22.13.10",
    "@types/screeps": "^3.3.8",
    "esbuild": "^0.25.1",
    "lodash": "^4.18.1",
    "screeps-server-mockup": "^1.5.1",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vitest": "^3.0.9"
  },
  "dependencies": {
    "@cursor/sdk": "^1.0.0"
  }
}
